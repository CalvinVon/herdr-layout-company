diff --git a/src/window/movable_tests.rs b/src/window/movable_tests.rs
new file mode 100644
index 0000000..9a60155
--- /dev/null
+++ b/src/window/movable_tests.rs
@@ -0,0 +1,137 @@
+#[test]
+fn floating_windows_only_drag_by_their_handle() {
+    in_own_process("window_handle_pointer");
+}
+
+#[gpui::test]
+fn window_handle_pointer(cx: &mut gpui::TestAppContext) {
+    use gpui::{Modifiers, MouseButton, Point, Pixels};
+    use serde_json::json;
+    if !running_alone("window_handle_pointer") { return; }
+    let (view, cx) = open_window(cx, "drag-probe", r#"
+import { View, div } from "gpui-kit";
+import { TextView } from "gpui-base";
+import { props, setShared } from "herdr";
+export default class Probe extends View {
+  render() {
+    if (props().title) {
+      return div().size_full().child(div().w(48).h(32)
+        .on_mouse_down("left", (_event, cx) => {
+          setShared("probe.control", true);
+          cx.stop_propagation();
+        }));
+    }
+    return div().size_full().child(TextView.markdown("document",
+      "Selectable markdown stays inside the floating window.")
+      .scrollable(false).selectable(true));
+  }
+}
+"#, json!({"id": "main", "type": "block", "content": {"tab": "active"}}));
+    cx.simulate_resize(size(px(1000.), px(700.)));
+    let spec = json!({
+        "kind": "window", "drag_handle": "title", "frame": "none",
+        "at": {"x": 100, "y": 100}, "width": 400, "height": 240,
+        "layout": {"id": "root", "type": "column", "resizable": false, "children": [
+            {"id": "title", "type": "block", "size": {"px": 32},
+             "content": {"mod": "drag-probe", "props": {"title": true}}},
+            {"id": "content", "type": "block", "content": {"mod": "drag-probe"}}
+        ]}
+    });
+    view.update_in(cx, |this, window, cx| {
+        this.open_overlay("first".into(), spec.clone(), window, cx);
+        let mut other = spec.clone();
+        other["at"]["x"] = json!(600);
+        this.open_overlay("other".into(), other, window, cx);
+        assert_eq!(this.overlays.iter().find(|o| o.id == "first").unwrap().drag_handle.as_deref(), Some("ovfirst/title"));
+    });
+    cx.run_until_parked();
+    let bounds = |cx: &mut gpui::VisualTestContext, id: &str| {
+        view.read_with(cx, |this, _| *this.bounds.borrow().get(id).unwrap())
+    };
+    let drag = |cx: &mut gpui::VisualTestContext, from: Point<Pixels>, to: Point<Pixels>| {
+        cx.simulate_mouse_down(from, MouseButton::Left, Modifiers::default());
+        cx.run_until_parked();
+        cx.simulate_mouse_move(to, Some(MouseButton::Left), Modifiers::default());
+        cx.simulate_mouse_up(to, MouseButton::Left, Modifiers::default());
+        cx.run_until_parked();
+    };
+    let original = bounds(cx, "overlay:first");
+    let content = bounds(cx, "ovfirst/content");
+    let from = content.origin + point(px(2.), px(10.));
+    let to = from + point(px(160.), px(0.));
+    drag(cx, from, to);
+    assert_eq!(bounds(cx, "overlay:first"), original, "content must not move the window");
+    assert!(view.read_with(cx, |this, _| this.win_drag.is_none()));
+    assert_eq!(view.read_with(cx, |this, _| this.overlays.last().unwrap().id.clone()), "first", "content still raises the window");
+    let selected = cx.update(|window, cx| gpui_base::TextSelection::selected_text(window, cx));
+    assert!(!selected.trim().is_empty(), "native TextView must receive the selection press and drag");
+    cx.simulate_keystrokes(if cfg!(target_os = "macos") { "cmd-c" } else { "ctrl-c" });
+    assert_eq!(cx.update(|_, cx| cx.read_from_clipboard().and_then(|item| item.text())), Some(selected.trim().to_owned()));
+    cx.simulate_mouse_move(to + point(px(80.), px(0.)), None, Modifiers::default());
+    assert_eq!(cx.update(|window, cx| gpui_base::TextSelection::selected_text(window, cx)), selected, "release ends selection dragging");
+
+    // A title control keeps its press, but the capture handler still raises it.
+    let other = bounds(cx, "ovother/content").origin + point(px(100.), px(10.));
+    cx.simulate_click(other, Modifiers::default());
+    cx.run_until_parked();
+    let title = bounds(cx, "ovfirst/title");
+    let control = title.origin + point(px(20.), px(16.));
+    drag(cx, control, control + point(px(100.), px(60.)));
+    assert_eq!(crate::mods::shared("probe.control"), Some(json!(true)));
+    assert_eq!(bounds(cx, "overlay:first"), original);
+    assert_eq!(view.read_with(cx, |this, _| this.overlays.last().unwrap().id.clone()), "first");
+
+    let title = title.origin + point(px(100.), px(16.));
+    drag(cx, title, title + point(px(2.), px(0.)));
+    assert_eq!(bounds(cx, "overlay:first"), original, "small presses stay clicks");
+    let delta = point(px(80.), px(60.));
+    drag(cx, title, title + delta);
+    assert_eq!(bounds(cx, "overlay:first").origin, original.origin + delta);
+    assert_eq!(view.read_with(cx, |this, _| this.overlays.last().unwrap().place), Some(original.origin + delta));
+    let title = bounds(cx, "ovfirst/title").origin + point(px(100.), px(16.));
+    drag(cx, title, title + point(px(10000.), px(10000.)));
+    let viewport = cx.update(|window, _| window.viewport_size());
+    assert_eq!(bounds(cx, "overlay:first").origin, point(viewport.width - px(48.), viewport.height - px(48.)), "drag stays clamped on screen");
+    view.update_in(cx, |this, window, cx| {
+        this.remove_overlay("first", window, cx);
+        this.remove_overlay("other", window, cx);
+    });
+
+    // The same real pointer path covers legacy windows and invalid/hidden handles.
+    for (handle, hidden, terminal, movable) in [
+        (None, false, false, true),
+        (Some("missing"), false, false, false),
+        (Some("title"), true, false, false),
+        (None, false, true, false),
+        (Some("content"), false, true, false),
+    ] {
+        let mut spec = spec.clone();
+        spec["drag_handle"] = json!(handle);
+        spec["layout"]["children"][0]["hidden"] = json!(hidden);
+        if terminal {
+            spec["layout"]["children"][1]["content"] = json!({"terminal": "t1"});
+        }
+        view.update_in(cx, |this, window, cx| this.open_overlay("first".into(), spec, window, cx));
+        cx.run_until_parked();
+        let before = bounds(cx, "overlay:first");
+        let from = bounds(cx, "ovfirst/content").origin + point(px(100.), px(if hidden { 10. } else { 60. }));
+        if hidden {
+            assert!(bounds(cx, "ovfirst/title").contains(&from), "the hidden title retained stale bounds");
+        }
+        drag(cx, from, from + delta);
+        assert_eq!(bounds(cx, "overlay:first").origin, if movable { before.origin + delta } else { before.origin }, "handle={handle:?}, hidden={hidden}, terminal={terminal}");
+        view.update_in(cx, |this, window, cx| this.remove_overlay("first", window, cx));
+    }
+
+    // Single-mod windows keep their old behavior even if given a block handle.
+    view.update_in(cx, |this, window, cx| this.open_overlay("single".into(), json!({
+        "kind": "window", "mod": "drag-probe", "drag_handle": "missing", "frame": "none",
+        "at": {"x": 100, "y": 100}, "width": 400, "height": 240
+    }), window, cx));
+    cx.run_until_parked();
+    assert!(view.read_with(cx, |this, _| this.overlays.last().unwrap().drag_handle.is_none()));
+    let before = bounds(cx, "overlay:single");
+    let from = before.origin + point(px(100.), px(100.));
+    drag(cx, from, from + delta);
+    assert_eq!(bounds(cx, "overlay:single").origin, before.origin + delta);
+}
